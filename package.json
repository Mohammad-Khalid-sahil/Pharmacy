{
  "name": "pharmacy-desktop",
  "version": "1.1.0",
  "description": "Pharmacy Management System desktop application",
  "main": "electron/main.js",
  "author": "mhShohan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run electron-dev",
    "frontend": "npm --prefix client run dev -- --host 127.0.0.1 --port 5173",
    "electron": "electron .",
    "electron-dev": "concurrently -k -n FRONTEND,ELECTRON -c cyan,magenta \"npm run frontend\" \"cross-env NODE_ENV=development ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "electron-start": "cross-env NODE_ENV=production electron .",
    "build": "npm --prefix client run build",
    "test:offline": "node scripts/offline-system-audit.js",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.pharmacy.desktop",
    "productName": "Pharmacy",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "client/dist",
        "to": "dist"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Pharmacy Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pharmacy",
      "uninstallDisplayName": "Pharmacy",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "asar": "^3.2.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2"
  }
}
